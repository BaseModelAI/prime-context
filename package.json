{
  "name": "prime-agent-context",
  "version": "8.1.1",
  "description": "Local paging for large Prime Agent tool output and a durable task snapshot",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaseModelAI/prime-context.git"
  },
  "homepage": "https://github.com/BaseModelAI/prime-context#readme",
  "bugs": {
    "url": "https://github.com/BaseModelAI/prime-context/issues"
  },
  "keywords": [
    "pi-package",
    "prime-agent",
    "context-management"
  ],
  "engines": {
    "node": ">=22.8.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "package:smoke": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.8.1/prime-agent-ai-0.8.1.tgz",
    "@earendil-works/pi-coding-agent": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.8.1/prime-agent-0.8.1.tgz",
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "typebox": "^1.3.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
